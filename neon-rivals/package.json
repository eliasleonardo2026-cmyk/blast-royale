{
  "name": "neon-rivals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"node server/server.mjs\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node server/server.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/server.mjs",
    "check": "node --check server/server.mjs && node --check src/game/simulation.js"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
